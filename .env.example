# ADMIN_UID: Firebase Auth UID of authorized administrator(s) (comma-separated if multiple)
# Required for admin-only operations (blob upload/list/delete/get, orders management)
ADMIN_UID="your-firebase-admin-uid"

# FIREBASE_PROJECT_ID: Firebase project ID used to verify ID tokens
FIREBASE_PROJECT_ID="gen-lang-client-0174410808"

# BLOB_READ_WRITE_TOKEN: Token for Vercel Blob private storage.
# Configure this in your Vercel Project Settings > Environment Variables.
BLOB_READ_WRITE_TOKEN="MY_BLOB_READ_WRITE_TOKEN"

# DATABASE_URL: Neon Serverless PostgreSQL connection string for the orders table.
# Configure this in your Vercel Project Settings > Environment Variables.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@unpooled-host/neondb?sslmode=require"

# UPSTASH_REDIS_REST_URL & UPSTASH_REDIS_REST_TOKEN: Upstash Redis for distributed rate limiting on Vercel
# Configure this in your Vercel Project Settings > Environment Variables or via Vercel Upstash Integration.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
