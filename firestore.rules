rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test document (read-only)
    match /test/connection {
      allow get: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000));
    }

    function isValidVaultItem(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'secretContent', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'secretContent', 'category', 'createdAt', 'updatedAt']) &&
        data.id is string && isValidId(data.id) &&
        data.ownerId is string && data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.secretContent is string && data.secretContent.size() <= 10000 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50));
    }

    // User Profile Documents - strictly isolated to the authenticated owner
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false; // Blanket enumeration of users is strictly prohibited
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Confidential Vault items - zero-trust private data not visible on public site
    match /vault/{vaultId} {
      allow get: if isValidId(vaultId) && isSignedIn() && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(vaultId) && isSignedIn() &&
        incoming().id == vaultId &&
        incoming().ownerId == request.auth.uid &&
        isValidVaultItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(vaultId) && isSignedIn() &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isValidVaultItem(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'secretContent', 'category', 'updatedAt']);
      allow delete: if isValidId(vaultId) && isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
